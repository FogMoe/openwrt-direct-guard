#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# shellcheck disable=SC2034,SC3043

START=18
STOP=89
USE_PROCD=1

PROG=/usr/sbin/direct-guard

start_service() {
	local enabled learn

	config_load direct-guard
	config_get_bool enabled main enabled 0
	config_get_bool learn main learn 1

	"$PROG" apply || return 1
	[ "$enabled" = 1 ] && [ "$learn" = 1 ] || return 0

	procd_open_instance watch
	procd_set_param command "$PROG" watch
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$PROG" snapshot
}

service_triggers() {
	procd_add_reload_trigger direct-guard
}
