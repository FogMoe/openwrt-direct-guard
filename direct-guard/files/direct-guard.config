config global 'main'
	option enabled '0'
	option backend 'auto'
	list allow_dev 'br-lan'
	option learn '1'
	option dnsmasq_conf '/etc/dnsmasq.conf'
	option dnsmasq_restart '1'
	option snapshot_interval '60'
	option log '0'

config target 'example'
	option enabled '0'
	list domain 'example.com'
	list cidr '192.0.2.0/24'
	list cidr '2001:db8::/32'
